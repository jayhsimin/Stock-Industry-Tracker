<div class="scrim" id="scrim"></div>
<aside class="drawer" id="drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
  <div class="drawer-head">
    <div>
      <h3 id="drawer-title"></h3>
      <div class="drawer-sub" id="drawer-sub"></div>
    </div>
    <button type="button" class="drawer-close" id="drawer-close" aria-label="關閉">✕</button>
  </div>
  <div class="drawer-body" id="drawer-body"></div>
</aside>

<div class="tooltip" id="tooltip"></div>

<script type="application/json" id="dashboard-data">__DATA_JSON__</script>
<script>
(function () {
  "use strict";
  var DATA = JSON.parse(document.getElementById("dashboard-data").textContent);
  var svg = d3.select("#bubble-svg");
  var tooltip = document.getElementById("tooltip");
  var scrim = document.getElementById("scrim");
  var drawer = document.getElementById("drawer");
  var mode = "concepts";
  var tableMode = false;

  document.getElementById("as-of").textContent = "資料時間：" + DATA.date;

  // Local-file mode auto-reloads the whole page every RELOAD_SECONDS (see
  // that countdown further below) to pick up fresh data on disk - a plain
  // location.reload() would otherwise always snap back to whichever view
  // is the static HTML's default (題材雷達) regardless of what the viewer
  // had open, since a full reload re-runs this script from scratch with no
  // memory of prior state. localStorage is the one thing that survives a
  // same-origin reload, so UI state the viewer is actively looking at
  // (active tab, which stock is pulled up) is saved there and restored at
  // the end of this script - wrapped in try/catch since a private window
  // or blocked site data can make localStorage throw rather than just
  // return null.
  function lsGet(key) {
    try { return localStorage.getItem(key); } catch (e) { return null; }
  }
  function lsSet(key, value) {
    try { localStorage.setItem(key, value); } catch (e) { /* ignore */ }
  }

  function fmtPct(v) {
    var s = (v > 0 ? "+" : "") + v.toFixed(2) + "%";
    return s;
  }
  function arrow(v) { return v > 0 ? "▲" : v < 0 ? "▼" : "‒"; }
  function dirClass(v) { return v > 0 ? "up" : v < 0 ? "down" : ""; }

  // shared by every chart on the dashboard: a 資料內容/公式/代表意義 box
  // right under the chart, so a reader never has to guess what's plotted,
  // how it was computed, or how to read the result.
  function chartExplainerHtml(dataDesc, formula, meaning) {
    return '<div class="chart-explainer">'
      + '<div class="chart-explainer-item"><div class="chart-explainer-label">資料內容</div>'
      + '<div class="chart-explainer-body">' + dataDesc + '</div></div>'
      + '<div class="chart-explainer-item"><div class="chart-explainer-label">公式</div>'
      + '<div class="chart-explainer-body">' + formula + '</div></div>'
      + '<div class="chart-explainer-item"><div class="chart-explainer-label">代表意義</div>'
      + '<div class="chart-explainer-body">' + meaning + '</div></div>'
      + '</div>';
  }

  function groupList(key) {
    var obj = DATA[key];
    return Object.keys(obj).map(function (name) {
      var g = obj[name];
      var nUp = g.stocks.filter(function (s) { return s.pct > 0; }).length;
      var nDown = g.stocks.filter(function (s) { return s.pct < 0; }).length;
      return { name: name, median_pct: g.median_pct, n_stocks: g.n_stocks, stocks: g.stocks, n_up: nUp, n_down: nDown };
    });
  }

  function renderKpis(list) {
    var byPct = list.slice().sort(function (a, b) { return b.median_pct - a.median_pct; });
    var topUp = byPct[0];
    var topDown = byPct[byPct.length - 1];
    var totalUp = list.reduce(function (a, g) { return a + g.n_up; }, 0);
    var totalDown = list.reduce(function (a, g) { return a + g.n_down; }, 0);

    var tiles = [
      { label: "領漲題材/產業", value: topUp.name, sub: fmtPct(topUp.median_pct), cls: "up" },
      { label: "領跌題材/產業", value: topDown.name, sub: fmtPct(topDown.median_pct), cls: "down" },
      { label: "分類數量", value: list.length + " 個", sub: "" },
      { label: "個股漲跌家數(去重前)", value: "", sub: totalUp + " 漲 / " + totalDown + " 跌" }
    ];

    var row = document.getElementById("kpi-row");
    row.innerHTML = "";
    tiles.forEach(function (t) {
      var el = document.createElement("div");
      el.className = "kpi";
      el.innerHTML =
        '<div class="kpi-label"></div><div class="kpi-value"></div>' +
        (t.sub ? '<div class="kpi-sub ' + (t.cls || "") + '"></div>' : "");
      el.querySelector(".kpi-label").textContent = t.label;
      el.querySelector(".kpi-value").textContent = t.value;
      if (t.sub) el.querySelector(".kpi-sub").textContent = t.sub;
      row.appendChild(el);
    });
  }

  function renderBubbles(list) {
    svg.selectAll("*").remove();
    var box = svg.node().getBoundingClientRect();
    var W = box.width || 1000, H = 560;
    svg.attr("viewBox", "0 0 " + W + " " + H);

    var maxAbs = d3.max(list, function (d) { return Math.abs(d.median_pct); }) || 1;
    var rScale = d3.scaleSqrt().domain([0, maxAbs]).range([16, Math.min(90, W / 9)]);

    var nodes = list.map(function (d) {
      return Object.assign({}, d, { r: rScale(Math.abs(d.median_pct)) });
    });

    var sim = d3.forceSimulation(nodes)
      .force("x", d3.forceX(W / 2).strength(0.06))
      .force("y", d3.forceY(H / 2).strength(0.06))
      .force("collide", d3.forceCollide(function (d) { return d.r + 2.5; }).iterations(3))
      .force("charge", d3.forceManyBody().strength(2))
      .stop();
    for (var i = 0; i < 180; i++) sim.tick();
    nodes.forEach(function (d) {
      d.x = Math.max(d.r + 2, Math.min(W - d.r - 2, d.x));
      d.y = Math.max(d.r + 2, Math.min(H - d.r - 2, d.y));
    });

    var g = svg.selectAll("g.bub-group")
      .data(nodes)
      .enter()
      .append("g")
      .attr("class", "bub-group")
      .attr("transform", function (d) { return "translate(" + d.x + "," + d.y + ")"; })
      .attr("tabindex", 0)
      .attr("role", "button")
      .attr("aria-label", function (d) {
        return d.name + " " + fmtPct(d.median_pct) + "，" + d.n_stocks + " 檔";
      });

    g.append("circle")
      .attr("r", function (d) { return d.r; })
      .attr("fill", function (d) {
        return d.median_pct >= 0 ? "var(--up-weak)" : "var(--down-weak)";
      })
      .attr("stroke", function (d) { return d.median_pct >= 0 ? "var(--up)" : "var(--down)"; })
      .attr("stroke-width", 1.5);

    // Breadth ring: a thin donut around each bubble split by n_up/n_down.
    // The bubble's own size/color only encode the MEDIAN move, which can't
    // tell "whole group drifted up together" apart from "one stock hit
    // limit-up, the rest were flat or down" - both can produce a similar
    // median. This ring shows which one it actually is: solid-colored ring
    // = consistent group move, visibly split ring = one or two stocks are
    // doing the work while the rest disagree.
    var arcGen = d3.arc();
    g.each(function (d) {
      var total = d.n_up + d.n_down;
      if (total <= 0) return;
      var upFrac = d.n_up / total;
      var upEnd = 2 * Math.PI * upFrac;
      var ring = d3.select(this).append("g").attr("class", "breadth-ring");
      if (d.n_up > 0) {
        ring.append("path")
          .attr("d", arcGen({ innerRadius: d.r + 1, outerRadius: d.r + 5, startAngle: 0, endAngle: upEnd }))
          .attr("fill", "var(--up)");
      }
      if (d.n_down > 0) {
        ring.append("path")
          .attr("d", arcGen({ innerRadius: d.r + 1, outerRadius: d.r + 5, startAngle: upEnd, endAngle: 2 * Math.PI }))
          .attr("fill", "var(--down)");
      }
    });

    g.append("circle").attr("class", "ring").attr("r", function (d) { return d.r + 8; });

    g.filter(function (d) { return d.r >= 26; })
      .append("text")
      .attr("class", "bub-name")
      .attr("text-anchor", "middle")
      .attr("y", function (d) { return d.r >= 40 ? -4 : 1; })
      .text(function (d) {
        var n = d.name;
        return n.length > 7 ? n.slice(0, 6) + "…" : n;
      });

    g.filter(function (d) { return d.r >= 40; })
      .append("text")
      .attr("class", "bub-pct")
      .attr("text-anchor", "middle")
      .attr("y", 12)
      .attr("fill", function (d) { return d.median_pct >= 0 ? "var(--up)" : "var(--down)"; })
      .text(function (d) { return arrow(d.median_pct) + " " + fmtPct(d.median_pct); });

    g.filter(function (d) { return d.r >= 55; })
      .append("text")
      .attr("class", "bub-n")
      .attr("text-anchor", "middle")
      .attr("y", 26)
      .attr("fill", "var(--text-muted)")
      .text(function (d) { return d.n_stocks + " 檔"; });

    function showTip(ev, d) {
      tooltip.innerHTML =
        '<div class="tt-name"></div><div class="tt-pct"></div><div></div>';
      tooltip.querySelector(".tt-name").textContent = d.name;
      var pctEl = tooltip.querySelector(".tt-pct");
      pctEl.textContent = arrow(d.median_pct) + " 中位數 " + fmtPct(d.median_pct);
      pctEl.style.color = d.median_pct >= 0 ? "#ff8f8e" : "#8fe08f";
      tooltip.children[2].textContent = d.n_stocks + " 檔（" + d.n_up + " 漲 " + d.n_down + " 跌）";
      tooltip.style.left = Math.min(ev.clientX + 14, window.innerWidth - 236) + "px";
      tooltip.style.top = Math.max(ev.clientY - 10, 8) + "px";
      tooltip.style.opacity = 1;
    }
    function hideTip() { tooltip.style.opacity = 0; }

    g.on("pointermove", showTip)
      .on("pointerenter", showTip)
      .on("pointerleave", hideTip)
      .on("click", function (ev, d) { openDrawer(d); })
      .on("keydown", function (ev, d) {
        if (ev.key === "Enter" || ev.key === " ") { ev.preventDefault(); openDrawer(d); }
      })
      .on("focus", function(ev,d){ showTip({clientX: d.x, clientY: d.y}, d); })
      .on("blur", hideTip);
  }

  function stockTableHTML(stocks, sortKey, asc) {
    var rows = stocks.slice().sort(function (a, b) {
      var av = a[sortKey], bv = b[sortKey];
      if (sortKey === "pct") { av = Math.abs(av); bv = Math.abs(bv); }
      return asc ? av - bv : bv - av;
    });
    var html = '<table class="movers"><thead><tr>' +
      '<th data-k="code">代號</th><th data-k="name">名稱</th>' +
      '<th class="num" data-k="close">收盤</th><th class="num" data-k="pct">漲跌%</th>' +
      '</tr></thead><tbody>';
    rows.forEach(function (s) {
      html += '<tr><td class="code">' + s.code + '</td><td></td>' +
        '<td class="num">' + (s.close != null ? s.close : "–") + '</td>' +
        '<td class="num pct ' + dirClass(s.pct) + '">' + arrow(s.pct) + " " + fmtPct(s.pct) + '</td></tr>';
    });
    html += "</tbody></table>";
    return { html: html, rows: rows };
  }

  function fillNames(container, rows) {
    var tds = container.querySelectorAll("tbody tr td:nth-child(2)");
    tds.forEach(function (td, i) { td.textContent = rows[i].name; });
  }

  function openDrawer(d) {
    document.getElementById("drawer-title").textContent = d.name;
    document.getElementById("drawer-sub").textContent =
      arrow(d.median_pct) + " 中位數 " + fmtPct(d.median_pct) + " · " + d.n_stocks + " 檔（" + d.n_up + " 漲 " + d.n_down + " 跌）";
    var body = document.getElementById("drawer-body");
    var built = stockTableHTML(d.stocks, "pct", false);
    body.innerHTML = built.html;
    fillNames(body, built.rows);
    attachSort(body, d.stocks, "pct", false);
    drawer.classList.add("open");
    scrim.classList.add("open");
  }
  function closeDrawer() {
    drawer.classList.remove("open");
    scrim.classList.remove("open");
  }
  document.getElementById("drawer-close").addEventListener("click", closeDrawer);
  scrim.addEventListener("click", closeDrawer);
  document.addEventListener("keydown", function (ev) {
    if (ev.key === "Escape") closeDrawer();
  });

  function attachSort(container, stocks, initKey, initAsc) {
    var key = initKey, asc = initAsc;
    container.querySelectorAll("th[data-k]").forEach(function (th) {
      th.addEventListener("click", function () {
        var k = th.getAttribute("data-k");
        asc = (k === key) ? !asc : false;
        key = k;
        var built = stockTableHTML(stocks, key, asc);
        container.innerHTML = built.html;
        fillNames(container, built.rows);
        attachSort(container, stocks, key, asc);
      });
    });
  }

  function renderTableView(list) {
    var el = document.getElementById("table-view");
    var sorted = list.slice().sort(function (a, b) { return b.median_pct - a.median_pct; });
    var html = '<table class="movers"><thead><tr><th>分類</th><th class="num">中位數漲跌%</th><th class="num">檔數</th><th class="num">漲/跌</th></tr></thead><tbody>';
    sorted.forEach(function (g) {
      html += '<tr><td style="cursor:pointer" data-open="' + g.name + '"></td>' +
        '<td class="num pct ' + dirClass(g.median_pct) + '">' + arrow(g.median_pct) + " " + fmtPct(g.median_pct) + '</td>' +
        '<td class="num">' + g.n_stocks + '</td>' +
        '<td class="num">' + g.n_up + ' / ' + g.n_down + '</td></tr>';
    });
    html += "</tbody></table>";
    el.innerHTML = html;
    el.querySelectorAll("td[data-open]").forEach(function (td, i) {
      td.textContent = sorted[i].name;
      td.addEventListener("click", function () { openDrawer(sorted[i]); });
    });
  }

  function render() {
    var list = groupList(mode);
    var modeLabel = mode === "concepts" ? "自建題材（concept_map 手動分類）" : "官方產業（industry_map，來自月營收申報）";
    document.getElementById("chart-title").textContent =
      (mode === "concepts" ? "自建題材" : "官方產業") + " · 依中位數漲跌幅排序，泡泡大小 = 漲跌幅度";
    renderKpis(list);
    if (tableMode) { renderTableView(list); } else { renderBubbles(list); }
    document.getElementById("radar-chart-explainer").innerHTML = chartExplainerHtml(
      "每個分類（" + modeLabel + "）底下每檔成分股最新一筆收盤價與當日漲跌幅（%），"
        + "來自 <code>stock_price</code> 的 ClosingPrice/Change。",
      "泡泡大小／中位數漲跌幅 = <code>MEDIAN(成分股當日漲跌%)</code>，用中位數不用平均值，"
        + "避免單一檔漲停/跌停把整個分類拉動；外環比例 = <code>上漲家數 : 下跌家數</code>。",
      "泡泡越大代表該分類當天整體波動越明顯，顏色代表漲（紅）跌（綠，台股慣例）。外環同色表示成分股同向移動，"
        + "外環混色則只有部分個股在動，此時中位數不一定能代表多數成分股的實際表現，點進去看個股明細比較準。"
    );
  }

  document.querySelectorAll('.segmented button').forEach(function (btn) {
