<title>題材雷達</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
<style>
  :root {
    color-scheme: light;
    --bg: #f5f7fa;
    --surface: #ffffff;
    --surface-2: #edf1f6;
    --border: rgba(16,24,33,0.10);
    --text-primary: #10151c;
    --text-secondary: #4d5566;
    --text-muted: #868d9e;
    --accent: #2a78d6;
    --accent-weak: #e6f0fb;
    --up: #e34948;
    --up-weak: #fbe6e5;
    --down: #008300;
    --down-weak: #e2f1e2;
    --ma5: 76, 124, 246;
    --ma10: 139, 92, 246;
    --ma20: 230, 140, 30;
    --ma60: 214, 51, 132;
    --radius-s: 8px;
    --radius-m: 14px;
    font-size: 16px;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --bg: #0c0e12;
      --surface: #14171d;
      --surface-2: #1b1f27;
      --border: rgba(255,255,255,0.10);
      --text-primary: #f3f4f6;
      --text-secondary: #b5bbc9;
      --text-muted: #70778a;
      --accent: #3987e5;
      --accent-weak: #16263b;
      --up: #e66767;
      --up-weak: #391c1c;
      --down: #008300;
      --down-weak: #152a17;
      --ma5: 108, 147, 255;
      --ma10: 167, 139, 250;
      --ma20: 244, 184, 96;
      --ma60: 244, 114, 182;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #0c0e12;
    --surface: #14171d;
    --surface-2: #1b1f27;
    --border: rgba(255,255,255,0.10);
    --text-primary: #f3f4f6;
    --text-secondary: #b5bbc9;
    --text-muted: #70778a;
    --accent: #3987e5;
    --accent-weak: #16263b;
    --up: #e66767;
    --up-weak: #391c1c;
    --down: #008300;
    --down-weak: #152a17;
    --ma5: 108, 147, 255;
    --ma10: 167, 139, 250;
    --ma20: 244, 184, 96;
    --ma60: 244, 114, 182;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text-primary);
    font-family: "IBM Plex Sans", "Noto Sans TC", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .page {
    max-width: 1180px;
    margin: 0 auto;
    padding-inline: 20px;
    padding-block: 28px 56px;
  }

  .masthead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-bottom: 22px;
  }
  .masthead h1 {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .masthead .meta {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .live-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.74rem;
    color: var(--down);
    margin-bottom: 16px;
    font-weight: 600;
  }
  .live-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--down);
    animation: live-pulse 1.6s ease-in-out infinite;
  }
  @keyframes live-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 18px;
  }
  .segmented {
    display: inline-flex;
    background: var(--surface-2);
    border-radius: 999px;
    padding: 3px;
    gap: 2px;
  }
  .segmented button {
    appearance: none;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    font-weight: 600;
    font-size: 0.86rem;
    padding: 7px 18px;
    border-radius: 999px;
    cursor: pointer;
    transition: background .15s, color .15s;
  }
  .segmented button[aria-pressed="true"] {
    background: var(--accent);
    color: #fff;
  }
  .view-toggle {
    appearance: none;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-secondary);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 500;
    padding: 7px 14px;
    border-radius: 999px;
    cursor: pointer;
  }
  .view-toggle:hover { border-color: var(--accent); color: var(--accent); }

  .kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 20px;
  }
  .kpi {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    padding: 13px 16px;
  }
  .kpi .kpi-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 6px;
  }
  .kpi .kpi-value {
    font-size: 1.15rem;
    font-weight: 600;
    font-family: "Noto Sans TC", "IBM Plex Sans", sans-serif;
  }
  .kpi .kpi-sub {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.86rem;
    margin-top: 2px;
  }
  .kpi .kpi-sub.up { color: var(--up); }
  .kpi .kpi-sub.down { color: var(--down); }

  .chart-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    padding: 6px;
    position: relative;
  }
  .chart-card .chart-caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px 0;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chart-caption h2 {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-secondary);
  }
  .legend {
    display: flex;
    gap: 16px;
    font-size: 0.78rem;
    color: var(--text-secondary);
  }
  .legend span { display: inline-flex; align-items: center; gap: 6px; }
  .legend i { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .legend i.up { background: var(--up); }
  .legend i.down { background: var(--down); }
  .chart-note {
    margin: 6px 16px 0;
    font-size: 0.74rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  #bubble-svg { display: block; width: 100%; height: 560px; touch-action: manipulation; }
  #bubble-svg text { font-family: "Noto Sans TC", "IBM Plex Sans", sans-serif; fill: var(--text-primary); pointer-events: none; }
  #bubble-svg .bub-group { cursor: pointer; }
  #bubble-svg .bub-group:focus { outline: none; }
  #bubble-svg .bub-group:focus circle.ring { stroke: var(--accent); stroke-width: 2.5px; }
  #bubble-svg circle.ring { fill: none; stroke: transparent; }
  #bubble-svg .bub-name { font-size: 11px; font-weight: 600; }
  #bubble-svg .bub-pct { font-family: "IBM Plex Mono", monospace; font-size: 10px; font-weight: 600; }
  #bubble-svg .bub-n { font-size: 9px; }

  table.movers {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
  }
  table.movers th {
    text-align: left;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    font-weight: 600;
    padding: 8px 10px;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    user-select: none;
  }
  table.movers td {
    padding: 8px 10px;
    border-bottom: 1px solid var(--border);
  }
  table.movers tbody tr:hover { background: var(--surface-2); }
  td.num, th.num { text-align: right; font-family: "IBM Plex Mono", monospace; font-variant-numeric: tabular-nums; }
  td.pct.up { color: var(--up); }
  td.pct.down { color: var(--down); }
  td.code { font-family: "IBM Plex Mono", monospace; color: var(--text-muted); }

  .table-wrap { padding: 4px 10px 14px; overflow-x: auto; }

  .ma-legend { display: flex; gap: 18px; align-items: center; margin: 2px 0 14px; flex-wrap: wrap; }
  .ma-legend span { display: inline-flex; align-items: center; gap: 6px; font-size: 0.82rem; color: var(--text-secondary); }
  .ma-legend i { width: 11px; height: 11px; border-radius: 3px; display: inline-block; }
  .ma-legend i.ma5 { background: rgb(var(--ma5)); }
  .ma-legend i.ma10 { background: rgb(var(--ma10)); }
  .ma-legend i.ma20 { background: rgb(var(--ma20)); }
  .ma-legend i.ma60 { background: rgb(var(--ma60)); }
  .ma-note { color: var(--text-muted); font-size: 0.82rem; margin: 0 0 14px; max-width: 760px; }
  td.ma-close { font-weight: 600; }
  td.ma-cell-5 { background: rgba(var(--ma5), 0.42); }
  td.ma-cell-10 { background: rgba(var(--ma10), 0.42); }
  td.ma-cell-20 { background: rgba(var(--ma20), 0.42); }
  td.ma-cell-60 { background: rgba(var(--ma60), 0.42); }

  .tooltip {
    position: fixed;
    pointer-events: none;
    background: var(--text-primary);
    color: var(--bg);
    font-size: 0.78rem;
    padding: 8px 11px;
    border-radius: var(--radius-s);
    line-height: 1.5;
    z-index: 50;
    opacity: 0;
    transition: opacity .1s;
    max-width: 220px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.25);
  }
  .tooltip .tt-name { font-weight: 700; margin-bottom: 2px; }
  .tooltip .tt-pct { font-family: "IBM Plex Mono", monospace; }

  .scrim {
    position: fixed; inset: 0;
    background: rgba(10,12,16,0.35);
    opacity: 0; pointer-events: none;
    transition: opacity .18s;
    z-index: 60;
  }
  .scrim.open { opacity: 1; pointer-events: auto; }

  .drawer {
    position: fixed;
    top: 0; right: 0; bottom: 0;
    width: min(420px, 92vw);
    background: var(--surface);
    border-left: 1px solid var(--border);
    transform: translateX(100%);
    transition: transform .22s cubic-bezier(.3,.8,.4,1);
    z-index: 61;
    display: flex;
    flex-direction: column;
    padding-top: env(safe-area-inset-top, 0px);
  }
  .drawer.open { transform: translateX(0); }
  .drawer-head {
    padding: 18px 20px 12px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
  }
  .drawer-head h3 { margin: 0 0 4px; font-size: 1.05rem; font-family: "Noto Sans TC", sans-serif; }
  .drawer-head .drawer-sub { font-size: 0.8rem; color: var(--text-secondary); font-family: "IBM Plex Mono", monospace; }
  .drawer-close {
    appearance: none; border: none; background: var(--surface-2); color: var(--text-secondary);
    width: 30px; height: 30px; border-radius: 50%; font-size: 1rem; cursor: pointer; flex: none;
  }
  .drawer-close:hover { background: var(--border); }
  .drawer-body { overflow-y: auto; padding: 10px 20px 24px; }
  .drawer-body table.movers td, .drawer-body table.movers th { padding: 7px 6px; }

  .empty-note { color: var(--text-muted); font-size: 0.85rem; padding: 40px 20px; text-align: center; }

  .page-nav {
    display: inline-flex;
    background: var(--surface-2);
    border-radius: 999px;
    padding: 3px;
    gap: 2px;
    margin-bottom: 20px;
  }
  .page-nav button {
    appearance: none;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 8px 20px;
    border-radius: 999px;
    cursor: pointer;
    transition: background .15s, color .15s;
  }
  .page-nav button[aria-pressed="true"] {
    background: var(--accent);
    color: #fff;
  }

  .strategy-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    padding: 18px 20px;
    margin-bottom: 16px;
  }
  .strategy-card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-bottom: 4px;
  }
  .strategy-card-head h3 {
    margin: 0;
    font-size: 1.1rem;
    font-family: "Noto Sans TC", sans-serif;
  }
  .status-pill {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 999px;
    letter-spacing: 0.02em;
  }
  .status-pill.active { background: var(--down-weak); color: var(--down); }
  .status-pill.draft { background: var(--accent-weak); color: var(--accent); }
  .strategy-schedule {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 14px;
  }
  .decision-group + .decision-group { margin-top: 14px; }
  .decision-group-title {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 8px;
  }
  .decision-item {
    padding: 10px 0;
    border-top: 1px solid var(--border);
  }
  .decision-group .decision-item:first-of-type { border-top: none; padding-top: 0; }
  .decision-item-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }
  .decision-item-head .title { font-weight: 600; font-size: 0.92rem; }
  .decision-item-head .date {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    color: var(--text-muted);
    flex: none;
  }
  .decision-rule {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-top: 3px;
    line-height: 1.5;
  }
  .decision-rationale {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-top: 4px;
    line-height: 1.55;
  }

  .history-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    padding: 18px 20px;
  }
  .history-card h3 { margin: 0 0 12px; font-size: 1rem; font-family: "Noto Sans TC", sans-serif; }
  .history-row {
    display: flex;
    gap: 12px;
    padding: 8px 0;
    border-top: 1px solid var(--border);
    font-size: 0.84rem;
    align-items: baseline;
  }
  .history-row:first-of-type { border-top: none; }
  .history-row .date { font-family: "IBM Plex Mono", monospace; color: var(--text-muted); flex: none; width: 88px; }
  .history-row .strategy-tag {
    flex: none;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text-secondary);
  }
  .history-row .what { color: var(--text-primary); }

  @media (max-width: 640px) {
    .kpi-row { grid-template-columns: repeat(2, 1fr); }
    #bubble-svg { height: 460px; }
    .history-row { flex-wrap: wrap; }
    .history-row .date { width: auto; }
  }

  .profile-search { position: relative; max-width: 420px; margin-bottom: 18px; }
  .profile-search input {
    width: 100%; box-sizing: border-box; font: inherit; font-size: 0.95rem;
    padding: 10px 36px 10px 14px; border-radius: var(--radius-s); border: 1px solid var(--border);
    background: var(--surface); color: var(--text-primary); cursor: pointer;
  }
  .profile-search input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .profile-search::after {
    content: "▾"; position: absolute; right: 13px; top: 50%; transform: translateY(-50%);
    color: var(--text-muted); font-size: 0.8rem; pointer-events: none;
  }
  .profile-suggestions {
    position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 5;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-s);
    max-height: 320px; overflow-y: auto; box-shadow: 0 8px 24px rgba(0,0,0,0.12);
  }
  .profile-suggestions div {
    padding: 9px 14px; cursor: pointer; font-size: 0.9rem; color: var(--text-primary);
    border-bottom: 1px solid var(--border);
  }
  .profile-suggestions div:last-child { border-bottom: none; }
  .profile-suggestions div:hover, .profile-suggestions div.active { background: var(--accent-weak); }
  .profile-suggestions .sub { color: var(--text-muted); font-size: 0.8rem; margin-left: 6px; }
  .profile-header { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 4px; }
  .profile-header h2 { margin: 0; }
  .profile-header .tag {
    font-size: 0.78rem; padding: 2px 9px; border-radius: 999px;
    background: var(--surface-2); color: var(--text-secondary);
  }
  .profile-meta { color: var(--text-secondary); font-size: 0.88rem; margin-bottom: 16px; }
  .profile-section-title {
    font-size: 0.95rem; font-weight: 600; color: var(--text-primary);
    margin: 22px 0 10px; display: flex; align-items: center; gap: 8px;
  }
  .profile-section-title:first-of-type { margin-top: 4px; }
  .calendar-tag {
    font-size: 0.72rem; padding: 1px 7px; border-radius: 999px; font-weight: 600;
  }
  .calendar-tag.upcoming { background: var(--up-weak); color: var(--up); }
  .calendar-tag.past { background: var(--surface-2); color: var(--text-muted); }

  .margin-chart-card { margin: 10px 0 24px; }
  .margin-chart-wrap, .market-chart-wrap { position: relative; }
  .margin-chart-wrap svg, .market-chart-wrap svg { display: block; width: 100%; }
  .margin-focus-axis text, .margin-context-axis text {
    fill: var(--text-muted); font-size: 0.72rem; font-family: "IBM Plex Mono", monospace;
  }
  .margin-focus-axis path, .margin-focus-axis line,
  .margin-context-axis path, .margin-context-axis line { stroke: var(--border); }
  .margin-focus-gridline { stroke: var(--border); stroke-dasharray: 2,3; }
  .margin-focus-line { fill: none; stroke: var(--accent); stroke-width: 2px; }
  .margin-context-area { fill: var(--accent); opacity: 0.18; }
  .margin-context-line { fill: none; stroke: var(--accent); stroke-width: 1px; opacity: 0.6; }
  .margin-brush .selection { fill: var(--accent); fill-opacity: 0.12; stroke: var(--accent); }
  .margin-brush .handle { fill: var(--accent); }
  .margin-crosshair-line { stroke: var(--text-muted); stroke-width: 1px; stroke-dasharray: 3,3; pointer-events: none; }
  .margin-crosshair-dot { fill: var(--accent); stroke: var(--surface); stroke-width: 1.5px; pointer-events: none; }
  .margin-tooltip {
    position: absolute; pointer-events: none; background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-s); padding: 6px 10px; font-size: 0.78rem; color: var(--text-primary);
    box-shadow: 0 6px 18px rgba(0,0,0,0.14); white-space: nowrap; display: none;
  }
  .margin-tooltip .t-date { color: var(--text-muted); margin-bottom: 2px; }
  .margin-empty-hint { color: var(--text-muted); font-size: 0.8rem; margin-top: 6px; }

  .chart-explainer {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
    background: var(--border); border: 1px solid var(--border); border-radius: var(--radius-s);
    margin-top: 14px; overflow: hidden;
  }
  .chart-explainer-item { background: var(--surface-2); padding: 11px 14px; }
  .chart-explainer-label {
    font-size: 0.72rem; font-weight: 600; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 5px;
  }
  .chart-explainer-body { font-size: 0.8rem; color: var(--text-secondary); line-height: 1.55; }
  .chart-explainer-body code {
    font-family: "IBM Plex Mono", monospace; font-size: 0.78rem; color: var(--text-primary);
    background: var(--surface); padding: 1px 5px; border-radius: 4px;
  }
  @media (max-width: 640px) {
    .chart-explainer { grid-template-columns: 1fr; }
  }
</style>

<div class="page">
  <div class="masthead">
    <h1>題材雷達</h1>
    <div class="meta" id="as-of"></div>
  </div>
  <div id="live-badge" style="display:none" class="live-badge"><span class="live-dot"></span>即時連線中</div>
  <div id="reload-badge" class="live-badge" style="color:var(--text-muted)">
    <span class="live-dot" style="background:var(--text-muted);animation:none"></span>
    <span id="reload-countdown"></span>秒後自動重整頁面（讀取本機最新資料）
  </div>

  <div class="page-nav" role="tablist" aria-label="頁面">
    <button type="button" role="tab" aria-pressed="true" data-page="radar">題材雷達</button>
    <button type="button" role="tab" aria-pressed="false" data-page="decisions">交易決策</button>
    <button type="button" role="tab" aria-pressed="false" data-page="ma">均線總覽</button>
    <button type="button" role="tab" aria-pressed="false" data-page="margin">融資融券</button>
    <button type="button" role="tab" aria-pressed="false" data-page="profile">個股基本面</button>
  </div>

  <div id="view-radar">
