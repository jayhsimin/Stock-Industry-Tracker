  // --- 個股基本面 tab: per-company fundamentals (financials, dividends,
  // revenue, EPS, current PE, shareholder-meeting/ex-dividend calendar,
  // annual/monthly price range), embedded as DATA.stock_profiles via
  // build_stock_profiles_cache.py's cache (stock_profile.py's queries) -
  // not recomputed live, same reasoning as ma_table.
  var profileIndex = [];
  var profileSuggestIdx = -1;

  function buildProfileIndex() {
    var profiles = (DATA.stock_profiles && DATA.stock_profiles.profiles) || {};
    profileIndex = Object.keys(profiles).map(function (code) {
      var p = profiles[code];
      var c = p && p.company || {};
      return { code: code, name: c["公司簡稱"] || c["公司名稱"] || code, profile: p };
    });
  }

  function fmtProfileNum(v) {
    if (v === null || v === undefined || v === "") return "—";
    var n = Number(v);
    return isNaN(n) ? v : n.toLocaleString();
  }
  function fmtProfilePct(v) {
    if (v === null || v === undefined || v === "") return "—";
    var n = Number(v);
    return isNaN(n) ? "—" : fmtPct(n);
  }

  function renderProfileSuggestions(matches) {
    var el = document.getElementById("profile-suggestions");
    profileSuggestIdx = -1;
    if (!matches.length) { el.style.display = "none"; el.innerHTML = ""; return; }
    el.innerHTML = matches.map(function (m) {
      return '<div data-code="' + m.code + '">' + m.name + '<span class="sub">' + m.code + '</span></div>';
    }).join("");
    el.style.display = "block";
    el.querySelectorAll("div").forEach(function (row) {
      row.addEventListener("click", function () { selectProfile(row.getAttribute("data-code")); });
    });
  }

  var ACTIVE_PROFILE_CODE_KEY = "twDashboardActiveProfileCode";

  function selectProfile(code) {
    var entry = profileIndex.find(function (m) { return m.code === code; });
    document.getElementById("profile-suggestions").style.display = "none";
    if (!entry) return;
    document.getElementById("profile-search-input").value = entry.name + "（" + entry.code + "）";
    renderProfileContent(entry.profile);
    lsSet(ACTIVE_PROFILE_CODE_KEY, code);
  }

  function profileSection(title) {
    return '<div class="profile-section-title">' + title + '</div>';
  }

  function kpiTile(label, value, subHtml) {
    return '<div class="kpi"><div class="kpi-label">' + label + '</div><div class="kpi-value">' + value + '</div>'
      + (subHtml || "") + '</div>';
  }

  function marginDeltaSub(curr, prevVal, decimals, suffix) {
    if (curr == null || prevVal == null) return "";
    var diff = curr - prevVal;
    if (Math.abs(diff) < Math.pow(10, -decimals) / 2) return '<div class="kpi-sub">持平（較前一交易日）</div>';
    var cls = diff > 0 ? "up" : "down";
    return '<div class="kpi-sub ' + cls + '">' + (diff > 0 ? "+" : "") + diff.toFixed(decimals) + (suffix || "")
      + ' 較前一交易日</div>';
  }

  function renderMarginSummaryHtml(p) {
    var mh = p.margin_history || [];
    if (!mh.length) {
      return profileSection("融資融券狀況") +
        '<div class="empty-note">尚無融資融券歷史資料（margin_trading 可能還沒針對此股票累積資料）</div>';
    }
    var latest = mh[mh.length - 1];
    var prev = mh.length > 1 ? mh[mh.length - 2] : null;
    var html = profileSection("融資融券狀況（" + latest.date + "　累積 " + mh.length + " 個交易日歷史）");
    html += '<div class="kpi-row">'
      + kpiTile("融資餘額(張)", latest.margin_balance_lots.toLocaleString(),
          prev ? marginDeltaSub(latest.margin_balance_lots, prev.margin_balance_lots, 0, "") : "")
      + kpiTile("融券餘額(張)", latest.short_balance_lots.toLocaleString(),
          prev ? marginDeltaSub(latest.short_balance_lots, prev.short_balance_lots, 0, "") : "")
      + kpiTile("資券比", latest.short_margin_ratio != null ? latest.short_margin_ratio : "—",
          prev ? marginDeltaSub(latest.short_margin_ratio, prev.short_margin_ratio, 4, "") : "")
      + kpiTile("融資使用率", latest.margin_usage_pct != null ? latest.margin_usage_pct + "%" : "—",
          prev ? marginDeltaSub(latest.margin_usage_pct, prev.margin_usage_pct, 2, "%") : "")
      + '</div>';

    var mc = p.margin_call;
    if (mc) {
      html += '<div class="kpi-row">'
        + kpiTile("估計融資斷頭價", mc.margin_call_price,
            '<div class="kpi-sub ' + (mc.margin_distance_pct < 0 ? "up" : "") + '">現價距此 '
            + (mc.margin_distance_pct >= 0 ? "+" : "") + mc.margin_distance_pct.toFixed(2) + "%"
            + (mc.margin_distance_pct < 0 ? "（已跌破）" : "") + '</div>')
        + kpiTile("估計融券斷頭價", mc.short_call_price,
            '<div class="kpi-sub ' + (mc.short_distance_pct < 0 ? "up" : "") + '">現價距此 '
            + (mc.short_distance_pct >= 0 ? "+" : "") + mc.short_distance_pct.toFixed(2) + "%"
            + (mc.short_distance_pct < 0 ? "（已漲破）" : "") + '</div>')
        + '</div>';
      html += '<p class="margin-empty-hint">估計斷頭價 = 本月加權均價（' + mc.basis_price + '，當作目前在外融資/融券部位的概略成本）'
        + ' × (1 − 22% 融資 / 1 + 46% 融券)。這兩個百分比是概略經驗值，不是TWSE/TPEx公布的個股實際融資成數/融券保證金成數'
        + '（每檔不同，此資料來源沒有提供），僅供概算參考，不是精確的維持率數字。</p>';
    } else {
      html += '<div class="empty-note">無法估算斷頭距離（缺少本月加權均價或現價 - TPEx股票或剛上市個股常見此情況）</div>';
    }

    html += '<div class="segmented" role="tablist" aria-label="歷史走勢指標" style="margin:4px 0 10px">'
      + '<button type="button" role="tab" aria-pressed="true" data-margin-metric="short_margin_ratio">資券比</button>'
      + '<button type="button" role="tab" aria-pressed="false" data-margin-metric="margin_usage_pct">融資使用率</button>'
      + '<button type="button" role="tab" aria-pressed="false" data-margin-metric="margin_balance_lots">融資餘額(張)</button>'
      + '<button type="button" role="tab" aria-pressed="false" data-margin-metric="short_balance_lots">融券餘額(張)</button>'
      + '</div>';
    html += '<div class="margin-chart-card">'
      + '<div class="margin-chart-wrap"><svg id="margin-focus-svg"></svg><div id="margin-tooltip" class="margin-tooltip"></div></div>'
      + '<svg id="margin-context-svg"></svg>'
      + '<p class="margin-empty-hint">下方灰色區為完整歷史範圍 - 拖曳或縮放選取範圍即可放大查看任意區間，' +
        '預設只顯示近期；放大選取範圍即可一路看到最早的資料。</p>'
      + '<div id="margin-chart-explainer"></div>'
      + '</div>';
    return html;
  }

  // --- generic focus+context brush history chart (d3), shared by the
  // 個股基本面 tab's per-stock 融資融券 chart AND the 全市場融資融券概況
  // card's market-wide chart - the context strip always shows the FULL
  // history at a glance; dragging/resizing the brush there zooms the focus
  // chart above it into any range, all the way back to the earliest data
  // point. Default brush = most recent ~30 points (or everything, if there
  // isn't 30 yet). opts: {focusSel, contextSel, tooltipId, wrapSel, data,
  // metricKey, metric} - metric is {label, decimals, suffix}.
  function drawHistoryChart(opts) {
    var focusSvg = d3.select(opts.focusSel);
    var contextSvg = d3.select(opts.contextSel);
    if (focusSvg.empty() || contextSvg.empty()) return;
    focusSvg.selectAll("*").remove();
    contextSvg.selectAll("*").remove();

    var metric = opts.metric;
    var metricKey = opts.metricKey;
    var points = opts.data
      .map(function (d) { return { date: new Date(d.date), value: d[metricKey], raw: d }; })
      .filter(function (d) { return d.value !== null && d.value !== undefined && !isNaN(d.date.getTime()); });

    // explainer box updates with whichever metric is currently selected,
    // since each one has its own formula/meaning - not just rendered once.
    if (opts.explainerSel && metric.dataDesc) {
      var explainerEl = document.querySelector(opts.explainerSel);
      if (explainerEl) explainerEl.innerHTML = chartExplainerHtml(metric.dataDesc, metric.formula, metric.meaning);
    }

    var wrap = document.querySelector(opts.wrapSel);
    var width = (wrap && wrap.getBoundingClientRect().width) || 600;
    var L = 48, R = 16;

    if (points.length < 2) {
      focusSvg.attr("viewBox", "0 0 " + width + " 80");
      focusSvg.append("text").attr("x", width / 2).attr("y", 40).attr("text-anchor", "middle")
        .attr("fill", "var(--text-muted)").attr("font-size", "0.82rem")
        .text(metric.label + "：資料點不足，無法繪圖");
      contextSvg.attr("viewBox", "0 0 " + width + " 1");
      return;
    }

    var focusH = 240, focusTop = 10, focusBottom = 28;
    var ctxH = 56, ctxTop = 4, ctxBottom = 18;

    // Zoom to the data's own range rather than forcing a 0 baseline - a
    // metric that sits far from zero with small day-to-day swings (e.g.
    // 平均距斷頭% hovering around 15) renders as an invisible flat line
    // against a 0-based axis; the real variation only becomes visible once
    // the axis is scaled to where the data actually lives. Axis ticks
    // still show the real numbers, so this isn't hiding anything - it's
    // the same reason a stock price chart doesn't start at $0.
    function paddedYDomain(values) {
      var ext = d3.extent(values);
      if (ext[0] == null) return [0, 1];
      var span = ext[1] - ext[0];
      var pad = span > 0 ? span * 0.12 : Math.max(Math.abs(ext[1]) * 0.08, 1e-6);
      return [ext[0] - pad, ext[1] + pad];
    }

    var xExtent = d3.extent(points, function (d) { return d.date; });
    var yDomainFull = paddedYDomain(points.map(function (d) { return d.value; }));

    var xContext = d3.scaleUtc().domain(xExtent).range([L, width - R]);
    var yContext = d3.scaleLinear().domain(yDomainFull).range([ctxH - ctxBottom, ctxTop]);
    var xFocus = d3.scaleUtc().range([L, width - R]);
    // yFocus's domain is NOT fixed here - redrawFocus() rescales it to
    // whichever subset of points is currently brushed, so zooming the
    // brush in also zooms the Y-axis to amplify that range's own variation.
    var yFocus = d3.scaleLinear().domain(yDomainFull).range([focusH - focusBottom, focusTop]);

    // --- context strip: full history, always visible ---
    contextSvg.attr("viewBox", "0 0 " + width + " " + ctxH);
    var areaGen = d3.area().x(function (d) { return xContext(d.date); })
      .y0(ctxH - ctxBottom).y1(function (d) { return yContext(d.value); });
    var lineGenCtx = d3.line().x(function (d) { return xContext(d.date); }).y(function (d) { return yContext(d.value); });
    contextSvg.append("path").datum(points).attr("class", "margin-context-area").attr("d", areaGen);
    contextSvg.append("path").datum(points).attr("class", "margin-context-line").attr("d", lineGenCtx);
    contextSvg.append("g").attr("class", "margin-context-axis")
      .attr("transform", "translate(0," + (ctxH - ctxBottom) + ")")
      .call(d3.axisBottom(xContext).ticks(Math.min(points.length, 6)).tickFormat(d3.utcFormat("%Y-%m-%d")).tickSizeOuter(0));

    var defaultSpan = Math.min(points.length, 30);
    var defaultStart = points[points.length - defaultSpan].date;
    var defaultEnd = points[points.length - 1].date;
    var defaultPixels = [xContext(defaultStart), xContext(defaultEnd)];
    if (defaultPixels[1] - defaultPixels[0] < 4) defaultPixels = [L, width - R];

    var brush = d3.brushX().extent([[L, ctxTop], [width - R, ctxH - ctxBottom]]).on("brush end", brushed);
    var brushG = contextSvg.append("g").attr("class", "margin-brush").call(brush);

    // --- focus chart: zoomed to whatever the brush currently selects ---
    focusSvg.attr("viewBox", "0 0 " + width + " " + focusH);
    var gridG = focusSvg.append("g");
    var axisXG = focusSvg.append("g").attr("class", "margin-focus-axis")
      .attr("transform", "translate(0," + (focusH - focusBottom) + ")");
    var axisYG = focusSvg.append("g").attr("class", "margin-focus-axis").attr("transform", "translate(" + L + ",0)");
    var lineGenFocus = d3.line().x(function (d) { return xFocus(d.date); }).y(function (d) { return yFocus(d.value); });
    var pathFocus = focusSvg.append("path").attr("class", "margin-focus-line");
    var crosshairX = focusSvg.append("line").attr("class", "margin-crosshair-line").style("display", "none");
    var crosshairDot = focusSvg.append("circle").attr("class", "margin-crosshair-dot").attr("r", 3.5).style("display", "none");
    var overlay = focusSvg.append("rect").attr("fill", "transparent")
      .attr("x", L).attr("y", focusTop).attr("width", Math.max(width - L - R, 0)).attr("height", focusH - focusTop - focusBottom);
    var tooltip = document.getElementById(opts.tooltipId);
    var bisectDate = d3.bisector(function (d) { return d.date; }).left;

    function redrawFocus(visible) {
      yFocus.domain(paddedYDomain(visible.map(function (d) { return d.value; })));
      var yAxisTicks = d3.axisLeft(yFocus).ticks(5).tickFormat(function (v) { return metric.decimals === 0 ? v.toLocaleString() : v.toFixed(metric.decimals); });
      axisYG.call(yAxisTicks);
      axisXG.call(d3.axisBottom(xFocus).ticks(Math.min(visible.length, 7)).tickFormat(d3.utcFormat("%m/%d")).tickSizeOuter(0));
      gridG.selectAll("line").data(yFocus.ticks(5)).join("line")
        .attr("class", "margin-focus-gridline")
        .attr("x1", L).attr("x2", width - R)
        .attr("y1", function (v) { return yFocus(v); }).attr("y2", function (v) { return yFocus(v); });
      pathFocus.datum(visible).attr("d", lineGenFocus);
    }

    function pointAtX(mouseX) {
      var x0 = xFocus.invert(mouseX);
      var domain = xFocus.domain();
      var visible = points.filter(function (d) { return d.date >= domain[0] && d.date <= domain[1]; });
      if (!visible.length) return null;
      var i = bisectDate(visible, x0, 1);
      var a = visible[i - 1], b = visible[i];
      if (!a) return b; if (!b) return a;
      return (x0 - a.date) > (b.date - x0) ? b : a;
    }

    overlay.on("mousemove", function (event) {
      var mx = d3.pointer(event, focusSvg.node())[0];
      var pt = pointAtX(mx);
      if (!pt) return;
      var px = xFocus(pt.date), py = yFocus(pt.value);
      crosshairX.attr("x1", px).attr("x2", px).attr("y1", focusTop).attr("y2", focusH - focusBottom).style("display", "");
      crosshairDot.attr("cx", px).attr("cy", py).style("display", "");
      tooltip.style.display = "block";
      tooltip.innerHTML = '<div class="t-date">' + d3.utcFormat("%Y-%m-%d")(pt.date) + "</div>"
        + metric.label + "：" + pt.value.toFixed(metric.decimals) + metric.suffix;
      var wrapBox = wrap.getBoundingClientRect();
      tooltip.style.left = Math.min(px + 12, wrapBox.width - 140) + "px";
      tooltip.style.top = Math.max(py - 36, 0) + "px";
    }).on("mouseleave", function () {
      crosshairX.style("display", "none");
      crosshairDot.style("display", "none");
      tooltip.style.display = "none";
    });

    function brushed(event) {
      var selection = (event && event.selection) || defaultPixels;
      var domain = selection.map(xContext.invert);
      var visible = points.filter(function (d) { return d.date >= domain[0] && d.date <= domain[1]; });
      if (visible.length < 2) {
        // selection too narrow (e.g. a single click, no drag) - fall back to
        // the full range rather than plotting every point against a domain
        // too narrow to hold them.
        xFocus.domain(xExtent);
        redrawFocus(points);
        return;
      }
      xFocus.domain(domain);
      redrawFocus(visible);
    }

    brushG.call(brush.move, defaultPixels);
  }

