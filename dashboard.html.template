<title>題材雷達</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
<style>
  :root {
    color-scheme: light;
    --bg: #f5f7fa;
    --surface: #ffffff;
    --surface-2: #edf1f6;
    --border: rgba(16,24,33,0.10);
    --text-primary: #10151c;
    --text-secondary: #4d5566;
    --text-muted: #868d9e;
    --accent: #2a78d6;
    --accent-weak: #e6f0fb;
    --up: #e34948;
    --up-weak: #fbe6e5;
    --down: #008300;
    --down-weak: #e2f1e2;
    --radius-s: 8px;
    --radius-m: 14px;
    font-size: 16px;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --bg: #0c0e12;
      --surface: #14171d;
      --surface-2: #1b1f27;
      --border: rgba(255,255,255,0.10);
      --text-primary: #f3f4f6;
      --text-secondary: #b5bbc9;
      --text-muted: #70778a;
      --accent: #3987e5;
      --accent-weak: #16263b;
      --up: #e66767;
      --up-weak: #391c1c;
      --down: #008300;
      --down-weak: #152a17;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #0c0e12;
    --surface: #14171d;
    --surface-2: #1b1f27;
    --border: rgba(255,255,255,0.10);
    --text-primary: #f3f4f6;
    --text-secondary: #b5bbc9;
    --text-muted: #70778a;
    --accent: #3987e5;
    --accent-weak: #16263b;
    --up: #e66767;
    --up-weak: #391c1c;
    --down: #008300;
    --down-weak: #152a17;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text-primary);
    font-family: "IBM Plex Sans", "Noto Sans TC", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .page {
    max-width: 1180px;
    margin: 0 auto;
    padding-inline: 20px;
    padding-block: 28px 56px;
  }

  .masthead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-bottom: 22px;
  }
  .masthead h1 {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .masthead .meta {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .live-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.74rem;
    color: var(--down);
    margin-bottom: 16px;
    font-weight: 600;
  }
  .live-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--down);
    animation: live-pulse 1.6s ease-in-out infinite;
  }
  @keyframes live-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 18px;
  }
  .segmented {
    display: inline-flex;
    background: var(--surface-2);
    border-radius: 999px;
    padding: 3px;
    gap: 2px;
  }
  .segmented button {
    appearance: none;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    font-weight: 600;
    font-size: 0.86rem;
    padding: 7px 18px;
    border-radius: 999px;
    cursor: pointer;
    transition: background .15s, color .15s;
  }
  .segmented button[aria-pressed="true"] {
    background: var(--accent);
    color: #fff;
  }
  .view-toggle {
    appearance: none;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-secondary);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 500;
    padding: 7px 14px;
    border-radius: 999px;
    cursor: pointer;
  }
  .view-toggle:hover { border-color: var(--accent); color: var(--accent); }

  .kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 20px;
  }
  .kpi {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    padding: 13px 16px;
  }
  .kpi .kpi-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 6px;
  }
  .kpi .kpi-value {
    font-size: 1.15rem;
    font-weight: 600;
    font-family: "Noto Sans TC", "IBM Plex Sans", sans-serif;
  }
  .kpi .kpi-sub {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.86rem;
    margin-top: 2px;
  }
  .kpi .kpi-sub.up { color: var(--up); }
  .kpi .kpi-sub.down { color: var(--down); }

  .chart-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    padding: 6px;
    position: relative;
  }
  .chart-card .chart-caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px 0;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chart-caption h2 {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-secondary);
  }
  .legend {
    display: flex;
    gap: 16px;
    font-size: 0.78rem;
    color: var(--text-secondary);
  }
  .legend span { display: inline-flex; align-items: center; gap: 6px; }
  .legend i { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .legend i.up { background: var(--up); }
  .legend i.down { background: var(--down); }
  .chart-note {
    margin: 6px 16px 0;
    font-size: 0.74rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  #bubble-svg { display: block; width: 100%; height: 560px; touch-action: manipulation; }
  #bubble-svg text { font-family: "Noto Sans TC", "IBM Plex Sans", sans-serif; fill: var(--text-primary); pointer-events: none; }
  #bubble-svg .bub-group { cursor: pointer; }
  #bubble-svg .bub-group:focus { outline: none; }
  #bubble-svg .bub-group:focus circle.ring { stroke: var(--accent); stroke-width: 2.5px; }
  #bubble-svg circle.ring { fill: none; stroke: transparent; }
  #bubble-svg .bub-name { font-size: 11px; font-weight: 600; }
  #bubble-svg .bub-pct { font-family: "IBM Plex Mono", monospace; font-size: 10px; font-weight: 600; }
  #bubble-svg .bub-n { font-size: 9px; }

  table.movers {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
  }
  table.movers th {
    text-align: left;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    font-weight: 600;
    padding: 8px 10px;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    user-select: none;
  }
  table.movers td {
    padding: 8px 10px;
    border-bottom: 1px solid var(--border);
  }
  table.movers tbody tr:hover { background: var(--surface-2); }
  td.num, th.num { text-align: right; font-family: "IBM Plex Mono", monospace; font-variant-numeric: tabular-nums; }
  td.pct.up { color: var(--up); }
  td.pct.down { color: var(--down); }
  td.code { font-family: "IBM Plex Mono", monospace; color: var(--text-muted); }

  .table-wrap { padding: 4px 10px 14px; overflow-x: auto; }

  .tooltip {
    position: fixed;
    pointer-events: none;
    background: var(--text-primary);
    color: var(--bg);
    font-size: 0.78rem;
    padding: 8px 11px;
    border-radius: var(--radius-s);
    line-height: 1.5;
    z-index: 50;
    opacity: 0;
    transition: opacity .1s;
    max-width: 220px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.25);
  }
  .tooltip .tt-name { font-weight: 700; margin-bottom: 2px; }
  .tooltip .tt-pct { font-family: "IBM Plex Mono", monospace; }

  .scrim {
    position: fixed; inset: 0;
    background: rgba(10,12,16,0.35);
    opacity: 0; pointer-events: none;
    transition: opacity .18s;
    z-index: 60;
  }
  .scrim.open { opacity: 1; pointer-events: auto; }

  .drawer {
    position: fixed;
    top: 0; right: 0; bottom: 0;
    width: min(420px, 92vw);
    background: var(--surface);
    border-left: 1px solid var(--border);
    transform: translateX(100%);
    transition: transform .22s cubic-bezier(.3,.8,.4,1);
    z-index: 61;
    display: flex;
    flex-direction: column;
    padding-top: env(safe-area-inset-top, 0px);
  }
  .drawer.open { transform: translateX(0); }
  .drawer-head {
    padding: 18px 20px 12px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
  }
  .drawer-head h3 { margin: 0 0 4px; font-size: 1.05rem; font-family: "Noto Sans TC", sans-serif; }
  .drawer-head .drawer-sub { font-size: 0.8rem; color: var(--text-secondary); font-family: "IBM Plex Mono", monospace; }
  .drawer-close {
    appearance: none; border: none; background: var(--surface-2); color: var(--text-secondary);
    width: 30px; height: 30px; border-radius: 50%; font-size: 1rem; cursor: pointer; flex: none;
  }
  .drawer-close:hover { background: var(--border); }
  .drawer-body { overflow-y: auto; padding: 10px 20px 24px; }
  .drawer-body table.movers td, .drawer-body table.movers th { padding: 7px 6px; }

  .empty-note { color: var(--text-muted); font-size: 0.85rem; padding: 40px 20px; text-align: center; }

  @media (max-width: 640px) {
    .kpi-row { grid-template-columns: repeat(2, 1fr); }
    #bubble-svg { height: 460px; }
  }
</style>

<div class="page">
  <div class="masthead">
    <h1>題材雷達</h1>
    <div class="meta" id="as-of"></div>
  </div>
  <div id="live-badge" style="display:none" class="live-badge"><span class="live-dot"></span>即時連線中</div>
  <div id="reload-badge" class="live-badge" style="color:var(--text-muted)">
    <span class="live-dot" style="background:var(--text-muted);animation:none"></span>
    <span id="reload-countdown"></span>秒後自動重整頁面（讀取本機最新資料）
  </div>

  <div class="toolbar">
    <div class="segmented" role="tablist" aria-label="分類方式">
      <button type="button" role="tab" aria-pressed="true" data-mode="concepts">自建題材</button>
      <button type="button" role="tab" aria-pressed="false" data-mode="industries">官方產業</button>
    </div>
    <button type="button" class="view-toggle" id="toggle-table">改用表格檢視</button>
  </div>

  <div class="kpi-row" id="kpi-row"></div>

  <div class="chart-card">
    <div class="chart-caption">
      <h2 id="chart-title">自建題材 · 依中位數漲跌幅排序，泡泡大小 = 漲跌幅度</h2>
      <div class="legend">
        <span><i class="up"></i>上漲</span>
        <span><i class="down"></i>下跌</span>
      </div>
    </div>
    <p class="chart-note">泡泡大小 = 中位數漲跌幅度（不受單一個股極端值拉動）；泡泡外環 = 成分股漲/跌家數比例——
      環越單一顏色代表整個族群同向移動，環被分成兩色代表只有部分個股在動，跟中位數不一致時要特別留意。</p>
    <svg id="bubble-svg" role="img" aria-label="題材漲跌幅泡泡圖"></svg>
    <div id="table-view" class="table-wrap" style="display:none"></div>
  </div>
</div>

<div class="scrim" id="scrim"></div>
<aside class="drawer" id="drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
  <div class="drawer-head">
    <div>
      <h3 id="drawer-title"></h3>
      <div class="drawer-sub" id="drawer-sub"></div>
    </div>
    <button type="button" class="drawer-close" id="drawer-close" aria-label="關閉">✕</button>
  </div>
  <div class="drawer-body" id="drawer-body"></div>
</aside>

<div class="tooltip" id="tooltip"></div>

<script type="application/json" id="dashboard-data">__DATA_JSON__</script>
<script>
(function () {
  "use strict";
  var DATA = JSON.parse(document.getElementById("dashboard-data").textContent);
  var svg = d3.select("#bubble-svg");
  var tooltip = document.getElementById("tooltip");
  var scrim = document.getElementById("scrim");
  var drawer = document.getElementById("drawer");
  var mode = "concepts";
  var tableMode = false;

  document.getElementById("as-of").textContent = "資料時間：" + DATA.date;

  function fmtPct(v) {
    var s = (v > 0 ? "+" : "") + v.toFixed(2) + "%";
    return s;
  }
  function arrow(v) { return v > 0 ? "▲" : v < 0 ? "▼" : "‒"; }
  function dirClass(v) { return v > 0 ? "up" : v < 0 ? "down" : ""; }

  function groupList(key) {
    var obj = DATA[key];
    return Object.keys(obj).map(function (name) {
      var g = obj[name];
      var nUp = g.stocks.filter(function (s) { return s.pct > 0; }).length;
      var nDown = g.stocks.filter(function (s) { return s.pct < 0; }).length;
      return { name: name, median_pct: g.median_pct, n_stocks: g.n_stocks, stocks: g.stocks, n_up: nUp, n_down: nDown };
    });
  }

  function renderKpis(list) {
    var byPct = list.slice().sort(function (a, b) { return b.median_pct - a.median_pct; });
    var topUp = byPct[0];
    var topDown = byPct[byPct.length - 1];
    var totalUp = list.reduce(function (a, g) { return a + g.n_up; }, 0);
    var totalDown = list.reduce(function (a, g) { return a + g.n_down; }, 0);

    var tiles = [
      { label: "領漲題材/產業", value: topUp.name, sub: fmtPct(topUp.median_pct), cls: "up" },
      { label: "領跌題材/產業", value: topDown.name, sub: fmtPct(topDown.median_pct), cls: "down" },
      { label: "分類數量", value: list.length + " 個", sub: "" },
      { label: "個股漲跌家數(去重前)", value: "", sub: totalUp + " 漲 / " + totalDown + " 跌" }
    ];

    var row = document.getElementById("kpi-row");
    row.innerHTML = "";
    tiles.forEach(function (t) {
      var el = document.createElement("div");
      el.className = "kpi";
      el.innerHTML =
        '<div class="kpi-label"></div><div class="kpi-value"></div>' +
        (t.sub ? '<div class="kpi-sub ' + (t.cls || "") + '"></div>' : "");
      el.querySelector(".kpi-label").textContent = t.label;
      el.querySelector(".kpi-value").textContent = t.value;
      if (t.sub) el.querySelector(".kpi-sub").textContent = t.sub;
      row.appendChild(el);
    });
  }

  function renderBubbles(list) {
    svg.selectAll("*").remove();
    var box = svg.node().getBoundingClientRect();
    var W = box.width || 1000, H = 560;
    svg.attr("viewBox", "0 0 " + W + " " + H);

    var maxAbs = d3.max(list, function (d) { return Math.abs(d.median_pct); }) || 1;
    var rScale = d3.scaleSqrt().domain([0, maxAbs]).range([16, Math.min(90, W / 9)]);

    var nodes = list.map(function (d) {
      return Object.assign({}, d, { r: rScale(Math.abs(d.median_pct)) });
    });

    var sim = d3.forceSimulation(nodes)
      .force("x", d3.forceX(W / 2).strength(0.06))
      .force("y", d3.forceY(H / 2).strength(0.06))
      .force("collide", d3.forceCollide(function (d) { return d.r + 2.5; }).iterations(3))
      .force("charge", d3.forceManyBody().strength(2))
      .stop();
    for (var i = 0; i < 180; i++) sim.tick();
    nodes.forEach(function (d) {
      d.x = Math.max(d.r + 2, Math.min(W - d.r - 2, d.x));
      d.y = Math.max(d.r + 2, Math.min(H - d.r - 2, d.y));
    });

    var g = svg.selectAll("g.bub-group")
      .data(nodes)
      .enter()
      .append("g")
      .attr("class", "bub-group")
      .attr("transform", function (d) { return "translate(" + d.x + "," + d.y + ")"; })
      .attr("tabindex", 0)
      .attr("role", "button")
      .attr("aria-label", function (d) {
        return d.name + " " + fmtPct(d.median_pct) + "，" + d.n_stocks + " 檔";
      });

    g.append("circle")
      .attr("r", function (d) { return d.r; })
      .attr("fill", function (d) {
        return d.median_pct >= 0 ? "var(--up-weak)" : "var(--down-weak)";
      })
      .attr("stroke", function (d) { return d.median_pct >= 0 ? "var(--up)" : "var(--down)"; })
      .attr("stroke-width", 1.5);

    // Breadth ring: a thin donut around each bubble split by n_up/n_down.
    // The bubble's own size/color only encode the MEDIAN move, which can't
    // tell "whole group drifted up together" apart from "one stock hit
    // limit-up, the rest were flat or down" - both can produce a similar
    // median. This ring shows which one it actually is: solid-colored ring
    // = consistent group move, visibly split ring = one or two stocks are
    // doing the work while the rest disagree.
    var arcGen = d3.arc();
    g.each(function (d) {
      var total = d.n_up + d.n_down;
      if (total <= 0) return;
      var upFrac = d.n_up / total;
      var upEnd = 2 * Math.PI * upFrac;
      var ring = d3.select(this).append("g").attr("class", "breadth-ring");
      if (d.n_up > 0) {
        ring.append("path")
          .attr("d", arcGen({ innerRadius: d.r + 1, outerRadius: d.r + 5, startAngle: 0, endAngle: upEnd }))
          .attr("fill", "var(--up)");
      }
      if (d.n_down > 0) {
        ring.append("path")
          .attr("d", arcGen({ innerRadius: d.r + 1, outerRadius: d.r + 5, startAngle: upEnd, endAngle: 2 * Math.PI }))
          .attr("fill", "var(--down)");
      }
    });

    g.append("circle").attr("class", "ring").attr("r", function (d) { return d.r + 8; });

    g.filter(function (d) { return d.r >= 26; })
      .append("text")
      .attr("class", "bub-name")
      .attr("text-anchor", "middle")
      .attr("y", function (d) { return d.r >= 40 ? -4 : 1; })
      .text(function (d) {
        var n = d.name;
        return n.length > 7 ? n.slice(0, 6) + "…" : n;
      });

    g.filter(function (d) { return d.r >= 40; })
      .append("text")
      .attr("class", "bub-pct")
      .attr("text-anchor", "middle")
      .attr("y", 12)
      .attr("fill", function (d) { return d.median_pct >= 0 ? "var(--up)" : "var(--down)"; })
      .text(function (d) { return arrow(d.median_pct) + " " + fmtPct(d.median_pct); });

    g.filter(function (d) { return d.r >= 55; })
      .append("text")
      .attr("class", "bub-n")
      .attr("text-anchor", "middle")
      .attr("y", 26)
      .attr("fill", "var(--text-muted)")
      .text(function (d) { return d.n_stocks + " 檔"; });

    function showTip(ev, d) {
      tooltip.innerHTML =
        '<div class="tt-name"></div><div class="tt-pct"></div><div></div>';
      tooltip.querySelector(".tt-name").textContent = d.name;
      var pctEl = tooltip.querySelector(".tt-pct");
      pctEl.textContent = arrow(d.median_pct) + " 中位數 " + fmtPct(d.median_pct);
      pctEl.style.color = d.median_pct >= 0 ? "#ff8f8e" : "#8fe08f";
      tooltip.children[2].textContent = d.n_stocks + " 檔（" + d.n_up + " 漲 " + d.n_down + " 跌）";
      tooltip.style.left = Math.min(ev.clientX + 14, window.innerWidth - 236) + "px";
      tooltip.style.top = Math.max(ev.clientY - 10, 8) + "px";
      tooltip.style.opacity = 1;
    }
    function hideTip() { tooltip.style.opacity = 0; }

    g.on("pointermove", showTip)
      .on("pointerenter", showTip)
      .on("pointerleave", hideTip)
      .on("click", function (ev, d) { openDrawer(d); })
      .on("keydown", function (ev, d) {
        if (ev.key === "Enter" || ev.key === " ") { ev.preventDefault(); openDrawer(d); }
      })
      .on("focus", function(ev,d){ showTip({clientX: d.x, clientY: d.y}, d); })
      .on("blur", hideTip);
  }

  function stockTableHTML(stocks, sortKey, asc) {
    var rows = stocks.slice().sort(function (a, b) {
      var av = a[sortKey], bv = b[sortKey];
      if (sortKey === "pct") { av = Math.abs(av); bv = Math.abs(bv); }
      return asc ? av - bv : bv - av;
    });
    var html = '<table class="movers"><thead><tr>' +
      '<th data-k="code">代號</th><th data-k="name">名稱</th>' +
      '<th class="num" data-k="close">收盤</th><th class="num" data-k="pct">漲跌%</th>' +
      '</tr></thead><tbody>';
    rows.forEach(function (s) {
      html += '<tr><td class="code">' + s.code + '</td><td></td>' +
        '<td class="num">' + (s.close != null ? s.close : "–") + '</td>' +
        '<td class="num pct ' + dirClass(s.pct) + '">' + arrow(s.pct) + " " + fmtPct(s.pct) + '</td></tr>';
    });
    html += "</tbody></table>";
    return { html: html, rows: rows };
  }

  function fillNames(container, rows) {
    var tds = container.querySelectorAll("tbody tr td:nth-child(2)");
    tds.forEach(function (td, i) { td.textContent = rows[i].name; });
  }

  function openDrawer(d) {
    document.getElementById("drawer-title").textContent = d.name;
    document.getElementById("drawer-sub").textContent =
      arrow(d.median_pct) + " 中位數 " + fmtPct(d.median_pct) + " · " + d.n_stocks + " 檔（" + d.n_up + " 漲 " + d.n_down + " 跌）";
    var body = document.getElementById("drawer-body");
    var built = stockTableHTML(d.stocks, "pct", false);
    body.innerHTML = built.html;
    fillNames(body, built.rows);
    attachSort(body, d.stocks, "pct", false);
    drawer.classList.add("open");
    scrim.classList.add("open");
  }
  function closeDrawer() {
    drawer.classList.remove("open");
    scrim.classList.remove("open");
  }
  document.getElementById("drawer-close").addEventListener("click", closeDrawer);
  scrim.addEventListener("click", closeDrawer);
  document.addEventListener("keydown", function (ev) {
    if (ev.key === "Escape") closeDrawer();
  });

  function attachSort(container, stocks, initKey, initAsc) {
    var key = initKey, asc = initAsc;
    container.querySelectorAll("th[data-k]").forEach(function (th) {
      th.addEventListener("click", function () {
        var k = th.getAttribute("data-k");
        asc = (k === key) ? !asc : false;
        key = k;
        var built = stockTableHTML(stocks, key, asc);
        container.innerHTML = built.html;
        fillNames(container, built.rows);
        attachSort(container, stocks, key, asc);
      });
    });
  }

  function renderTableView(list) {
    var el = document.getElementById("table-view");
    var sorted = list.slice().sort(function (a, b) { return b.median_pct - a.median_pct; });
    var html = '<table class="movers"><thead><tr><th>分類</th><th class="num">中位數漲跌%</th><th class="num">檔數</th><th class="num">漲/跌</th></tr></thead><tbody>';
    sorted.forEach(function (g) {
      html += '<tr><td style="cursor:pointer" data-open="' + g.name + '"></td>' +
        '<td class="num pct ' + dirClass(g.median_pct) + '">' + arrow(g.median_pct) + " " + fmtPct(g.median_pct) + '</td>' +
        '<td class="num">' + g.n_stocks + '</td>' +
        '<td class="num">' + g.n_up + ' / ' + g.n_down + '</td></tr>';
    });
    html += "</tbody></table>";
    el.innerHTML = html;
    el.querySelectorAll("td[data-open]").forEach(function (td, i) {
      td.textContent = sorted[i].name;
      td.addEventListener("click", function () { openDrawer(sorted[i]); });
    });
  }

  function render() {
    var list = groupList(mode);
    document.getElementById("chart-title").textContent =
      (mode === "concepts" ? "自建題材" : "官方產業") + " · 依中位數漲跌幅排序，泡泡大小 = 漲跌幅度";
    renderKpis(list);
    if (tableMode) { renderTableView(list); } else { renderBubbles(list); }
  }

  document.querySelectorAll('.segmented button').forEach(function (btn) {
    btn.addEventListener("click", function () {
      document.querySelectorAll('.segmented button').forEach(function (b) { b.setAttribute("aria-pressed", "false"); });
      btn.setAttribute("aria-pressed", "true");
      mode = btn.getAttribute("data-mode");
      render();
    });
  });

  document.getElementById("toggle-table").addEventListener("click", function () {
    tableMode = !tableMode;
    document.getElementById("bubble-svg").style.display = tableMode ? "none" : "block";
    document.getElementById("table-view").style.display = tableMode ? "block" : "none";
    this.textContent = tableMode ? "改用泡泡圖檢視" : "改用表格檢視";
    render();
  });

  window.addEventListener("resize", function () { if (!tableMode) render(); });

  render();

  // Live updates: if this artifact has the `db` capability, subscribe to
  // dashboard/latest and re-render whenever Claude pushes a fresh snapshot -
  // no page reload needed. Falls back silently to the static embedded data
  // (already rendered above) when db isn't available for this viewer.
  (async function initLive() {
    if (!window.claude || typeof window.claude.use !== "function") return;
    var dbCap;
    try {
      dbCap = await window.claude.use("db");
    } catch (e) {
      return;
    }
    if (!dbCap) return;

    dbCap.doc("dashboard/latest").onSnapshot(
      function (snap) {
        if (!snap.exists) return;
        var fresh = snap.data();
        if (!fresh || !fresh.industries || !fresh.concepts) return;
        DATA = fresh;
        document.getElementById("as-of").textContent = "資料時間：" + DATA.date;
        document.getElementById("live-badge").style.display = "inline-flex";
        render();
        clearReloadCountdown();
      },
      function (err) {
        document.getElementById("live-badge").style.display = "none";
      }
    );
  })();

  // Local-file mode: dashboard.html is regenerated on disk every
  // RELOAD_SECONDS by a scheduled task (see README's 純本機方案), so a
  // plain full-page reload picks up the newest embedded data - no db
  // capability needed. If the db live-subscribe above connects instead
  // (claude.ai-hosted with capability db), that's strictly better (no
  // reload flash), so it cancels this countdown.
  var RELOAD_SECONDS = 60;
  var reloadRemaining = RELOAD_SECONDS;
  var reloadTimer = setInterval(function () {
    reloadRemaining -= 1;
    var el = document.getElementById("reload-countdown");
    if (el) el.textContent = reloadRemaining;
    if (reloadRemaining <= 0) location.reload();
  }, 1000);
  function clearReloadCountdown() {
    clearInterval(reloadTimer);
    var badge = document.getElementById("reload-badge");
    if (badge) badge.style.display = "none";
  }
  document.getElementById("reload-countdown").textContent = reloadRemaining;
})();
</script>
