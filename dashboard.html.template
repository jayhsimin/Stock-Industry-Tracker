    if (p.calendar && p.calendar.length) {
      html += profileSection("重要行事曆（股東會／除權除息）");
      html += '<div class="table-wrap"><table class="movers"><thead><tr><th>狀態</th><th>類型</th>'
        + "<th>日期</th></tr></thead><tbody>";
      p.calendar.forEach(function (e) {
        html += '<tr><td><span class="calendar-tag ' + (e.upcoming ? "upcoming" : "past") + '">'
          + (e.upcoming ? "未來" : "已過") + "</span></td><td>" + e.type + "</td><td>" + (e.date || "—") + "</td></tr>";
      });
      html += "</tbody></table></div>";
    }

    html += profileSection("歷史價格區間");
    var pp = p.price_points || { annual: [], monthly: [] };
    if (pp.annual && pp.annual.length) {
      html += '<p class="chart-note">僅TWSE上市股票提供；目前資料為最近期（通常是最近一個已結束的完整年度）'
        + '的年度/月度高低點，尚未累積多年歷史。</p>';
      html += '<div class="table-wrap"><table class="movers"><thead><tr><th>年度</th>'
        + '<th class="num">最高價</th><th>最高日</th><th class="num">最低價</th><th>最低日</th>'
        + '<th class="num">年均價</th></tr></thead><tbody>';
      pp.annual.forEach(function (r) {
        html += "<tr><td>" + r["Year"] + '</td><td class="num">' + r["HighestPrice"] + "</td><td>" + r["HDate"]
          + '</td><td class="num">' + r["LowestPrice"] + "</td><td>" + r["LDate"]
          + '</td><td class="num">' + r["AvgClosingPrice"] + "</td></tr>";
      });
      html += "</tbody></table></div>";
      if (pp.monthly && pp.monthly.length) {
        html += '<div class="table-wrap"><table class="movers"><thead><tr><th>月份</th>'
          + '<th class="num">最高價</th><th class="num">最低價</th><th class="num">加權均價</th></tr></thead><tbody>';
        pp.monthly.forEach(function (r) {
          html += "<tr><td>" + r["Month"] + '</td><td class="num">' + r["HighestPrice"]
            + '</td><td class="num">' + r["LowestPrice"] + '</td><td class="num">' + r["WeightedAvgPriceAB"] + "</td></tr>";
        });
        html += "</tbody></table></div>";
      }
    } else {
      html += '<div class="empty-note">無資料（此資料集僅TWSE上市股票有提供，TPEx上櫃股票目前沒有對應來源）</div>';
    }

    el.innerHTML = html;
    initMarginHistoryChart(p.margin_history || []);
  }

  function renderProfileMarketOverview() {
    var el = document.getElementById("profile-market-overview");
    var m = DATA.margin_data || {};
    var s = m.summary;
    var history = m.history || [];
    var html = "";

    if (!s) {
      html += '<div class="empty-note">尚無全市場融資融券資料 - 請先執行 <code>python fetch_daily.py</code>'
        + '（會抓 margin_trading）。</div>';
    } else {
      var tiles = marketMarginTiles(s);
      html += '<p class="chart-note">資料日期：' + m.date + '（TWSE/TPEx 收盤後才公布，盤中無法即時更新；'
        + '已排除權證/ETF/債券，僅計 ' + s.n_stocks + ' 檔一般上市櫃公司 - 詳細排行/題材分布請見「融資融券」分頁）</p>';
      html += '<div class="kpi-row">' + tiles.map(function (t) {
        return kpiTile(t.label, t.value, t.sub ? '<div class="kpi-sub ' + (t.cls || "") + '">' + t.sub + '</div>' : "");
      }).join("") + '</div>';
    }

    // 市場平均斷頭距離：取 history 裡最新一個「有算出來」的點（不一定是陣列最後一筆，
    // 因為個別日期可能剛好全市場資料只有單一市場來源，算不出來 - 見 margin_report.py）
    var latestCallPoint = null;
    for (var i = history.length - 1; i >= 0; i--) {
      if (history[i].avg_margin_distance_pct != null || history[i].avg_short_distance_pct != null) {
        latestCallPoint = history[i];
        break;
      }
    }
    if (latestCallPoint) {
      html += '<div class="kpi-row">'
        + kpiTile("市場平均距融資斷頭",
            latestCallPoint.avg_margin_distance_pct != null ? latestCallPoint.avg_margin_distance_pct.toFixed(2) + "%" : "—",
            '<div class="kpi-sub ' + (latestCallPoint.avg_margin_distance_pct < 0 ? "up" : "") + '">'
            + latestCallPoint.date + '　張數加權平均</div>')
        + kpiTile("市場平均距融券斷頭",
            latestCallPoint.avg_short_distance_pct != null ? latestCallPoint.avg_short_distance_pct.toFixed(2) + "%" : "—",
            '<div class="kpi-sub ' + (latestCallPoint.avg_short_distance_pct < 0 ? "up" : "") + '">'
            + latestCallPoint.date + '　張數加權平均</div>')
        + '</div>';
      html += '<p class="margin-empty-hint">估計方式跟個股「融資融券狀況」相同（本月加權均價當成本基準，融資跌22%/融券漲46%視為' +
        '估計斷頭），再用每檔個股目前的融資/融券餘額加權平均成一個市場整體數字 - 僅涵蓋有近期股價與本月均價可查的TWSE上市公司。</p>';
    }

    if (history.length >= 2) {
      html += '<div class="segmented" role="tablist" aria-label="全市場歷史走勢指標" style="margin:14px 0 10px">'
        + '<button type="button" role="tab" aria-pressed="true" data-market-metric="market_short_margin_ratio">市場資券比</button>'
        + '<button type="button" role="tab" aria-pressed="false" data-market-metric="total_margin_lots">全市場融資餘額(張)</button>'
        + '<button type="button" role="tab" aria-pressed="false" data-market-metric="total_short_lots">全市場融券餘額(張)</button>'
        + '<button type="button" role="tab" aria-pressed="false" data-market-metric="avg_margin_distance_pct">平均距融資斷頭</button>'
        + '<button type="button" role="tab" aria-pressed="false" data-market-metric="avg_short_distance_pct">平均距融券斷頭</button>'
        + '</div>';
      html += '<div class="margin-chart-card">'
        + '<div class="market-chart-wrap"><svg id="market-focus-svg"></svg><div id="market-tooltip" class="margin-tooltip"></div></div>'
        + '<svg id="market-context-svg"></svg>'
        + '<p class="margin-empty-hint">張數加總不需要股價換算，所以涵蓋 margin_trading 累積到的每一天（即使那天 stock_price '
        + '還沒有對應資料）- 下方灰色區為完整歷史範圍，拖曳即可放大任意區間。</p>'
        + '<div id="market-chart-explainer"></div>'
        + '</div>';
    }

    el.innerHTML = html;
    if (history.length >= 2) initMarketHistoryChart(history);
  }

  (function initProfileTab() {
    renderProfileMarketOverview();
    buildProfileIndex();
    var note = document.getElementById("profile-cache-note");
    var cacheDate = DATA.stock_profiles && DATA.stock_profiles.date;
    note.textContent = cacheDate
      ? "基本面資料快取日期：" + cacheDate + "（執行 python build_stock_profiles_cache.py 更新，共 " + profileIndex.length + " 檔）"
      : "尚無基本面資料快取 - 請先執行 python build_stock_profiles_cache.py";

    var input = document.getElementById("profile-search-input");

    function matchesFor(q) {
      // like a combobox: empty query -> full list (sorted by code), like a
      // <select>'s dropdown; a query ranks exact code match first, then
      // code-prefix, then name-substring, so the best match is always
      // first - what Enter picks when nothing's been arrow-key-highlighted.
      if (!q) {
        return profileIndex.slice().sort(function (a, b) { return a.code.localeCompare(b.code); });
      }
      var exact = [], prefix = [], byName = [];
      profileIndex.forEach(function (m) {
        var code = m.code.toLowerCase(), name = m.name.toLowerCase();
        if (code === q) exact.push(m);
        else if (code.indexOf(q) === 0) prefix.push(m);
        else if (name.indexOf(q) !== -1) byName.push(m);
      });
      return exact.concat(prefix, byName);
    }

    function updateSuggestions() {
      var q = input.value.trim().toLowerCase();
      renderProfileSuggestions(matchesFor(q).slice(0, 50));
    }

    input.addEventListener("input", updateSuggestions);
    input.addEventListener("focus", function () {
      // like opening a <select>'s dropdown: always show the full list on
      // focus/click regardless of whatever text is already in the box
      // (e.g. "台積電（2330）" left over from a previous pick) - typing
      // (the "input" handler above) is what narrows it from there.
      input.select();
      renderProfileSuggestions(matchesFor("").slice(0, 50));
    });
    input.addEventListener("keydown", function (e) {
      var el = document.getElementById("profile-suggestions");
      var rows = el.querySelectorAll("div");
      if (!rows.length) return;
      if (e.key === "ArrowDown") { e.preventDefault(); profileSuggestIdx = Math.min(profileSuggestIdx + 1, rows.length - 1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); profileSuggestIdx = Math.max(profileSuggestIdx - 1, 0); }
      else if (e.key === "Enter") {
        e.preventDefault();
        rows[profileSuggestIdx >= 0 ? profileSuggestIdx : 0].click();
        return;
      } else if (e.key === "Escape") {
        el.style.display = "none";
        return;
      } else return;
      rows.forEach(function (r, i) { r.classList.toggle("active", i === profileSuggestIdx); });
      rows[profileSuggestIdx].scrollIntoView({ block: "nearest" });
    });
    document.addEventListener("click", function (e) {
      if (!e.target.closest(".profile-search")) document.getElementById("profile-suggestions").style.display = "none";
    });
  })();

  var PAGE_IDS = ["radar", "decisions", "ma", "margin", "profile"];
  var ACTIVE_PAGE_KEY = "twDashboardActivePage";

  // Shared by the nav click handler AND the restore-on-reload logic at the
  // end of this script, so "which tab was clicked" and "which tab to come
  // back to after an auto-reload" are never two different code paths that
  // could drift apart.
  function activatePage(page) {
    if (PAGE_IDS.indexOf(page) === -1) page = "radar";
    document.querySelectorAll(".page-nav button").forEach(function (b) {
      b.setAttribute("aria-pressed", b.getAttribute("data-page") === page ? "true" : "false");
    });
    PAGE_IDS.forEach(function (id) {
      document.getElementById("view-" + id).style.display = id === page ? "" : "none";
    });
    if (page === "radar" && !tableMode) render();
    lsSet(ACTIVE_PAGE_KEY, page);
  }

  document.querySelectorAll(".page-nav button").forEach(function (btn) {
    btn.addEventListener("click", function () { activatePage(btn.getAttribute("data-page")); });
  });

  // Restore whatever the viewer had open before this reload (see the
  // lsGet/lsSet note near the top of this script) - runs after
  // initProfileTab()'s IIFE above has already built profileIndex, so
  // selectProfile() has something to look the saved code up in. A page
  // freshly opened for the first time has nothing saved yet, so this is a
  // no-op and the static HTML's 題材雷達 default stands.
  (function restoreViewerState() {
    var savedPage = lsGet(ACTIVE_PAGE_KEY);
    if (savedPage && savedPage !== "radar") activatePage(savedPage);
    var savedCode = lsGet(ACTIVE_PROFILE_CODE_KEY);
    if (savedCode) selectProfile(savedCode);
  })();

  // Live updates: if this artifact has the `db` capability, subscribe to
  // dashboard/latest and re-render whenever Claude pushes a fresh snapshot -
  // no page reload needed. Falls back silently to the static embedded data
  // (already rendered above) when db isn't available for this viewer.
  (async function initLive() {
    if (!window.claude || typeof window.claude.use !== "function") return;
    var dbCap;
    try {
      dbCap = await window.claude.use("db");
    } catch (e) {
      return;
    }
    if (!dbCap) return;

    dbCap.doc("dashboard/latest").onSnapshot(
      function (snap) {
        if (!snap.exists) return;
        var fresh = snap.data();
        if (!fresh || !fresh.industries || !fresh.concepts) return;
        DATA = fresh;
        document.getElementById("as-of").textContent = "資料時間：" + DATA.date;
        document.getElementById("live-badge").style.display = "inline-flex";
        render();
        renderDecisions();
        renderMargin();
        buildProfileIndex();
        renderProfileMarketOverview();
        clearReloadCountdown();
      },
      function (err) {
        document.getElementById("live-badge").style.display = "none";
      }
    );
  })();

  // Local-file mode: dashboard.html is regenerated on disk every
  // RELOAD_SECONDS by a scheduled task (see README's 純本機方案), so a
  // plain full-page reload picks up the newest embedded data - no db
  // capability needed. If the db live-subscribe above connects instead
  // (claude.ai-hosted with capability db), that's strictly better (no
  // reload flash), so it cancels this countdown.
  var RELOAD_SECONDS = 60;
  var reloadRemaining = RELOAD_SECONDS;
  var reloadTimer = setInterval(function () {
    reloadRemaining -= 1;
    var el = document.getElementById("reload-countdown");
    if (el) el.textContent = reloadRemaining;
    if (reloadRemaining <= 0) location.reload();
  }, 1000);
  function clearReloadCountdown() {
    clearInterval(reloadTimer);
    var badge = document.getElementById("reload-badge");
    if (badge) badge.style.display = "none";
  }
  document.getElementById("reload-countdown").textContent = reloadRemaining;
})();
</script>
