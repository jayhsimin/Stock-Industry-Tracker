  document.getElementById("toggle-table").addEventListener("click", function () {
    tableMode = !tableMode;
    document.getElementById("bubble-svg").style.display = tableMode ? "none" : "block";
    document.getElementById("table-view").style.display = tableMode ? "block" : "none";
    this.textContent = tableMode ? "改用泡泡圖檢視" : "改用表格檢視";
    render();
  });

  window.addEventListener("resize", function () { if (!tableMode) render(); });

  render();

  // --- 交易決策 tab: static rulebook rendered from trading/decisions.json
  // (embedded as DATA.decisions by build_dashboard.py / build_dashboard_live.py).
  // Purely a read-only view of what's already decided - no editing here.
  var GROUP_LABELS = { entry: "進場條件", exit: "出場條件", sizing: "資金／下單", ranking: "排序規則" };
  var GROUP_ORDER = ["entry", "exit", "sizing", "ranking"];
  var STRATEGY_ORDER = ["swing", "daytrade"];
  var STATUS_LABELS = { active: "啟用中", draft: "草案" };

  function renderDecisions() {
    var dec = DATA.decisions || { strategies: {}, decisions: [] };
    var byStrategy = {};
    (dec.decisions || []).forEach(function (d) {
      (byStrategy[d.strategy] = byStrategy[d.strategy] || []).push(d);
    });

    var cardsEl = document.getElementById("strategy-cards");
    cardsEl.innerHTML = "";
    var order = STRATEGY_ORDER.filter(function (id) { return dec.strategies[id]; })
      .concat(Object.keys(dec.strategies).filter(function (id) { return STRATEGY_ORDER.indexOf(id) === -1; }));

    if (!order.length) {
      cardsEl.innerHTML = '<div class="empty-note">尚無已記錄的策略決策。</div>';
    }

    order.forEach(function (sid) {
      var meta = dec.strategies[sid];
      var items = byStrategy[sid] || [];
      var byGroup = {};
      items.forEach(function (d) { (byGroup[d.category] = byGroup[d.category] || []).push(d); });

      var card = document.createElement("div");
      card.className = "strategy-card";
      var head = document.createElement("div");
      head.className = "strategy-card-head";
      head.innerHTML =
        '<h3></h3><span class="status-pill"></span>';
      head.querySelector("h3").textContent = meta.name;
      var pill = head.querySelector(".status-pill");
      pill.classList.add(meta.status === "active" ? "active" : "draft");
      pill.textContent = STATUS_LABELS[meta.status] || meta.status;
      card.appendChild(head);

      var sched = document.createElement("div");
      sched.className = "strategy-schedule";
      sched.textContent = meta.schedule || "";
      card.appendChild(sched);

      GROUP_ORDER.filter(function (g) { return byGroup[g] && byGroup[g].length; }).forEach(function (g) {
        var group = document.createElement("div");
        group.className = "decision-group";
        var title = document.createElement("div");
        title.className = "decision-group-title";
        title.textContent = GROUP_LABELS[g] || g;
        group.appendChild(title);

        byGroup[g].forEach(function (d) {
          var item = document.createElement("div");
          item.className = "decision-item";
          item.innerHTML =
            '<div class="decision-item-head"><span class="title"></span><span class="date"></span></div>' +
            '<div class="decision-rule"></div><div class="decision-rationale"></div>';
          item.querySelector(".title").textContent = d.title;
          item.querySelector(".date").textContent = d.decided_date;
          item.querySelector(".decision-rule").textContent = d.rule;
          item.querySelector(".decision-rationale").textContent = d.rationale;
          group.appendChild(item);
        });
        card.appendChild(group);
      });

      if (!items.length) {
        var empty = document.createElement("div");
        empty.className = "empty-note";
        empty.style.padding = "8px 0";
        empty.textContent = "尚無細項規則。";
        card.appendChild(empty);
      }

      cardsEl.appendChild(card);
    });

    var historyEl = document.getElementById("history-list");
    historyEl.innerHTML = "";
    var allSorted = (dec.decisions || []).slice().sort(function (a, b) {
      return b.decided_date.localeCompare(a.decided_date);
    });
    if (!allSorted.length) {
      historyEl.innerHTML = '<div class="empty-note">尚無決策歷史。</div>';
    }
    allSorted.forEach(function (d) {
      var row = document.createElement("div");
      row.className = "history-row";
      row.innerHTML =
        '<span class="date"></span><span class="strategy-tag"></span><span class="what"></span>';
      row.querySelector(".date").textContent = d.decided_date;
      row.querySelector(".strategy-tag").textContent = (dec.strategies[d.strategy] || {}).name || d.strategy;
      row.querySelector(".what").textContent =
        (GROUP_LABELS[d.category] || d.category) + "：" + d.title + " — " + d.rule;
      historyEl.appendChild(row);
    });
  }
  renderDecisions();

  // --- 均線總覽 tab: MA5/10/20/60 come from build_ma_cache.py's
  // once-a-day cache (embedded as DATA.ma_table by build_dashboard.py /
  // build_dashboard_live.py); close is this run's live snapshot price. The
  // 現價 cell's background blends all four MA anchor colors, weighted by
  // inverse %-distance from close to each MA - closer to one MA's value
  // pulls the color toward that MA's own color.
  var MA_PERIODS = [5, 10, 20, 60];

  function maRgb(name) {
    var v = getComputedStyle(document.documentElement).getPropertyValue("--" + name).trim();
    return v.split(",").map(function (x) { return parseFloat(x); });
  }

  function blendCloseColor(close, r) {
    var eps = 1e-6;
    var available = MA_PERIODS.filter(function (p) { return r["ma" + p] != null; });
    var weights = available.map(function (p) {
      var dist = Math.abs(close - r["ma" + p]) / r["ma" + p];
      return 1 / (dist + eps);
    });
    var sum = weights.reduce(function (s, w) { return s + w; }, 0);
    var rgb = [0, 0, 0];
    available.forEach(function (p, i) {
      var c = maRgb("ma" + p);
      var w = weights[i] / sum;
      rgb[0] += c[0] * w; rgb[1] += c[1] * w; rgb[2] += c[2] * w;
    });
    return "rgba(" + rgb.map(Math.round).join(",") + ",0.42)";
  }

  function renderMaTable() {
    var ma = DATA.ma_table || { date: null, rows: [] };
    var el = document.getElementById("ma-table-view");
    if (!ma.rows.length) {
      el.innerHTML = '<div class="empty-note">尚無均線資料 - 請先執行 <code>python build_ma_cache.py</code>'
        + '（每天跑一次即可），並確認是用 build_dashboard_live.py 建置（EOD版沒有即時現價可比對）。</div>';
      return;
    }
    var rows = ma.rows.slice().sort(function (a, b) { return a.name.localeCompare(b.name, "zh-Hant"); });
    var html = '<table class="movers"><thead><tr>'
      + '<th>個股名稱</th><th>代號</th><th class="num">MA5</th><th class="num">MA10</th>'
      + '<th class="num">MA20</th><th class="num">MA60</th>'
      + '<th class="num">現價</th></tr></thead><tbody>';
    function maCell(p, r) {
      var v = r["ma" + p];
      return '<td class="num ma-cell-' + p + '">' + (v == null ? "—" : v.toFixed(2)) + '</td>';
    }
    rows.forEach(function (r) {
      var bg = blendCloseColor(r.close, r);
      html += "<tr><td>" + r.name + '</td><td class="code">' + r.code + '</td>'
        + maCell(5, r) + maCell(10, r) + maCell(20, r) + maCell(60, r)
        + '<td class="num ma-close" style="background:' + bg + '">' + r.close.toFixed(2) + "</td></tr>";
    });
    html += "</tbody></table>";
    el.innerHTML = html;
  }
  renderMaTable();

  // --- 融資融券 tab: EOD-only data (TWSE/TPEx publish 融資融券餘額 once
  // after close - no Shioaji live feed for it), embedded as DATA.margin_data
  // by margin_report.build_margin_data() via build_dashboard.py /
  // build_dashboard_live.py (same query either way, unlike ma_table/price).
  var marginRankMode = "margin_increase";
  var marginGroupMode = "concepts";

  function fmtNtdBillions(v) {
    if (v == null) return "—";
    return (v / 1e8).toFixed(1) + " 億";
  }
  function fmtLots(v) {
    if (v == null) return "—";
    return (v >= 0 ? "+" : "") + v.toLocaleString();
  }
  function fmtRatio(v) {
    return v == null ? "—" : v.toFixed(3);
  }
  function fmtUsagePct(v) {
    return v == null ? "—" : v.toFixed(1) + "%";
  }

  // shared by the 融資融券 tab's own summary and the 個股基本面 tab's
  // "全市場融資融券概況" overview, so both always agree with each other.
  function marketMarginTiles(s) {
    return [
      { label: "全市場融資餘額", value: fmtNtdBillions(s.total_margin_ntd),
        sub: fmtLots(s.margin_change_lots) + " 張", cls: s.margin_change_lots >= 0 ? "up" : "down" },
      { label: "全市場融券餘額", value: fmtNtdBillions(s.total_short_ntd),
        sub: fmtLots(s.short_change_lots) + " 張", cls: s.short_change_lots >= 0 ? "up" : "down" },
      { label: "市場資券比", value: fmtRatio(s.market_short_margin_ratio), sub: "融券/融資（張數）" },
      { label: "納入統計檔數", value: s.n_stocks + " 檔", sub: "" }
    ];
  }

  function renderMarginKpis() {
    var m = DATA.margin_data || {};
    var s = m.summary;
    var row = document.getElementById("margin-kpi-row");
    var note = document.getElementById("margin-date-note");
    if (!s) {
      row.innerHTML = '<div class="empty-note">尚無融資融券資料 - 請先執行 <code>python fetch_daily.py</code>'
        + '（會抓 margin_trading）。</div>';
      note.textContent = "";
      return;
    }
    note.textContent = "資料日期：" + m.date + "（TWSE/TPEx 收盤後才公布，盤中無法即時更新；"
      + "已排除權證/ETF/債券，僅計 " + s.n_stocks + " 檔一般上市櫃公司）";
    var tiles = marketMarginTiles(s);
    row.innerHTML = "";
    tiles.forEach(function (t) {
      var el = document.createElement("div");
      el.className = "kpi";
      el.innerHTML = '<div class="kpi-label"></div><div class="kpi-value"></div>'
        + (t.sub ? '<div class="kpi-sub ' + (t.cls || "") + '"></div>' : "");
      el.querySelector(".kpi-label").textContent = t.label;
      el.querySelector(".kpi-value").textContent = t.value;
      if (t.sub) el.querySelector(".kpi-sub").textContent = t.sub;
      row.appendChild(el);
    });
  }

  function renderMarginRankTable() {
    var m = DATA.margin_data || {};
    var rows = (m.rankings && m.rankings[marginRankMode]) || [];
    var el = document.getElementById("margin-rank-table");
    if (!rows.length) {
      el.innerHTML = '<div class="empty-note">尚無資料</div>';
      return;
    }
    var html = '<table class="movers"><thead><tr><th>個股</th><th>代號</th><th class="num">收盤價</th>'
      + '<th class="num">融資餘額(張)</th><th class="num">融資變化</th>'
      + '<th class="num">融券餘額(張)</th><th class="num">融券變化</th>'
      + '<th class="num">資券比</th><th class="num">融資使用率</th></tr></thead><tbody>';
    rows.forEach(function (r) {
      html += "<tr><td>" + r.name + '</td><td class="code">' + r.code + '</td>'
        + '<td class="num">' + (r.close != null ? r.close.toFixed(2) : "—") + '</td>'
        + '<td class="num">' + r.margin_balance_lots.toLocaleString() + '</td>'
        + '<td class="num">' + fmtLots(r.margin_change_lots) + '</td>'
        + '<td class="num">' + r.short_balance_lots.toLocaleString() + '</td>'
        + '<td class="num">' + fmtLots(r.short_change_lots) + '</td>'
        + '<td class="num">' + fmtRatio(r.short_margin_ratio) + '</td>'
        + '<td class="num">' + fmtUsagePct(r.margin_usage_pct) + '</td></tr>';
    });
    html += "</tbody></table>";
    el.innerHTML = html;
  }

  function renderMarginGroupTable() {
    var m = DATA.margin_data || {};
    var groups = (m.groups && m.groups[marginGroupMode]) || {};
    var el = document.getElementById("margin-group-table");
    var names = Object.keys(groups);
    if (!names.length) {
      el.innerHTML = '<div class="empty-note">尚無資料</div>';
      return;
    }
    names.sort(function (a, b) {
      return (groups[b].median_short_margin_ratio || 0) - (groups[a].median_short_margin_ratio || 0);
    });
    var html = '<table class="movers"><thead><tr><th>分類</th><th class="num">檔數</th>'
      + '<th class="num">資券比中位數</th><th class="num">融資變化(張)</th>'
      + '<th class="num">融券變化(張)</th></tr></thead><tbody>';
    names.forEach(function (name) {
      var g = groups[name];
      html += "<tr><td>" + name + '</td><td class="num">' + g.n_stocks + '</td>'
        + '<td class="num">' + fmtRatio(g.median_short_margin_ratio) + '</td>'
        + '<td class="num">' + fmtLots(g.margin_change_lots) + '</td>'
        + '<td class="num">' + fmtLots(g.short_change_lots) + '</td></tr>';
    });
    html += "</tbody></table>";
    el.innerHTML = html;
  }

  function renderMargin() {
    renderMarginKpis();
    renderMarginRankTable();
    renderMarginGroupTable();
  }
  renderMargin();

  document.querySelectorAll("[data-margin-rank]").forEach(function (btn) {
    btn.addEventListener("click", function () {
      document.querySelectorAll("[data-margin-rank]").forEach(function (b) { b.setAttribute("aria-pressed", "false"); });
      btn.setAttribute("aria-pressed", "true");
      marginRankMode = btn.getAttribute("data-margin-rank");
      renderMarginRankTable();
    });
  });
  document.querySelectorAll("[data-margin-group]").forEach(function (btn) {
    btn.addEventListener("click", function () {
      document.querySelectorAll("[data-margin-group]").forEach(function (b) { b.setAttribute("aria-pressed", "false"); });
      btn.setAttribute("aria-pressed", "true");
      marginGroupMode = btn.getAttribute("data-margin-group");
      renderMarginGroupTable();
    });
